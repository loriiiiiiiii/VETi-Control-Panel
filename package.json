{
  "name": "interaction-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based control panel for the VETi CivetWeb backend. Runs in a desktop browser or as an Android APK via Capacitor.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "tsc --noEmit",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@byrds/capacitor-mdns": "^7.0.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@fontsource-variable/inter": "^5.2.8",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
